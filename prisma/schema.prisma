  // Giáo viên phụ trách
  teacherId        String?
  teacher          User?    @relation("TutoringPlanTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  tutorName        String?  // Tên giáo viên/trợ giảng kèm hiển thị

  // Phân loại & Kỹ năng
  sessionType      String   @default("Bù bài học viên vắng (Makeup)")
  focusSkills      String   @default("Tổng hợp / Toàn diện")
  
  // Nội dung & Dặn dò
  content          String?  // Nội dung bài học & mục tiêu bù bài
  instructions     String?  // Dặn dò học viên / Phụ huynh (Đồ dùng mang theo)
  totalSessions    Int      @default(1) // Tổng số buổi dự kiến
  
  // Trạng thái tổng quát: SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  status           String   @default("SCHEDULED")
  createdById      String?  // User tạo lịch
  letterExportedAt DateTime? // Thời điểm xuất/copy thư gửi phụ huynh

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions         TutoringSession[]

  @@index([studentId, status])
  @@index([teacherId])
  @@index([classCode])
}

model TutoringSession {
  id               String   @id @default(uuid())
  planId           String
  plan             TutoringPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  sessionNumber    Int      @default(1) // Buổi số 1, 2, 3...
  teachingDate     String   // YYYY-MM-DD
  startTimeText    String?  // Nhập tự do (vd: 16:30, 04:30 CH, 17h)
  endTimeText      String?  // Nhập tự do (vd: 17:30, 05:30 CH, 18h30)
  roomName         String   @default("Phòng học tại trung tâm") // Dạy trực tiếp tại cơ sở

  notes            String?  // Ghi chú riêng cho buổi
  status           String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  
  // Điểm danh & Đánh giá tiếp thu sau buổi học
  attendanceStatus String?  // Có mặt, Đi trễ, Vắng mặt
  evaluation       String?  // Xuất sắc, Tốt, Trung bình, Cần cố gắng
  evaluationNotes  String?  // Nhận xét của giáo viên
  homeworkAssigned String?  // Bài tập về nhà giao thêm
  completedAt      DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([planId])
  @@index([teachingDate, status])
  @@index([roomName, teachingDate])
}

model TutoringAlertDismissal {
  id          Int      @id @default(autoincrement())
  studentId   String
  alertKey    String   // Key định danh cảnh báo
  reason      String?  // Lý do bỏ qua
  dismissedBy String?  // Tên người bấm bỏ qua
  createdAt   DateTime @default(now())

  @@unique([studentId, alertKey])
}

model AlertDismissal {
  alertKey    String   @id
  dismissedAt DateTime @default(now())
}




// ============================================
// HỒ SƠ ĐÁNH GIÁ & TIẾN TRÌNH HỌC TẬP (ASSESSMENTS & PORTFOLIO)
// ============================================

model StudentAssessment {
  id              Int       @id @default(autoincrement())
  
  // Liên kết Học viên chính thức hoặc Lead (Khách mới / Học thử)
  studentId       String?   // Mã học viên (nếu đã là học viên)
  student         Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  leadId          Int?      // Mã lead (nếu là khách mới / học thử)
  lead            Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  classCode       String?   // Mã lớp học liên quan (nếu có)
  
  // Phân loại đánh giá:
  // - PLACEMENT_TEST: Đánh giá năng lực đầu vào (Placement Test)
  // - TRIAL_EVALUATION: Đánh giá học thử
  // - PERIODIC_REVIEW: Nhận xét định kỳ
  // - ADHOC_REVIEW: Nhận xét đột xuất
  type            String    @default("PLACEMENT_TEST")
  
  title           String?   // Tiêu đề: "Đánh giá Năng lực Đầu vào", "Nhận xét Học thử", v.v.
  assessmentDate  DateTime  @default(now())
  assessorName    String?   // Giáo viên hoặc nhân viên đánh giá
  
  // Dữ liệu Điểm số (Lưu cả cấu trúc JSON và điểm tổng)
  scores          String?   // JSON: { listening: { score, max, weight }, speaking: ..., rw: ..., total: ... }
  totalScore      Float?    // Tổng điểm quy đổi (vd: 42.57)
  maxScore        Float?    @default(100)
  
  // Từ khóa gợi ý của giáo viên (Lưu JSON)
  // vd Placement: { lsKeywords, rwKeywords, devKeywords }
  // vd Trial: { attitude, skills, potential }
  // vd Adhoc: { speaking, listening, rw }
  keywords        String?
  
  // Lời nhận xét chi tiết (Lưu JSON)
  // vd Placement: { ls_comments, rw_comments, conclusion }
  // vd Trial: { attitude, skills, potential, recommendation, advice }
  // vd Adhoc: { speaking, listening, rw, dev }
  comments        String?
  
  // Ghi chú hoặc lộ trình đề xuất ngắn
  notes           String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([studentId])
  @@index([leadId])
  @@index([type])
  @@index([assessmentDate])
}


// ==========================================
// HỆ THỐNG KHẢO THÍ CHỨNG CHỈ QUỐC TẾ CAMBRIDGE (VN120)
// ==========================================

model CambridgeExamBatch {
  id                    String    @id @default(cuid()) // Mã đợt thi: vd CAM_2026_12 hoặc auto cuid
  title                 String    // Tên đợt thi: vd "Kỳ thi Cambridge Quốc tế Tháng 12/2026"
  examDate              DateTime? // Ngày thi chính thức
  registrationDeadline  DateTime? // Hạn chót đăng ký
  closeHour             String?   @default("23:59") // Giờ đóng form
  hotline               String?   @default("0911.767.069")
  authorizedCenter      String?   @default("VN120") // Hội đồng khảo thí ủy quyền
  companyName           String?   @default("CÔNG TY TNHH NGOẠI NGỮ TRI THỨC VIỆT")
  centerName            String?   @default("TRUNG TÂM ANH NGỮ NHẬT MỸ")
  bankAccount           String?   @default("6119916886")
  bankAccountName       String?   @default("CONG TY TNHH NGOAI NGU TRI THUC VIET")
  bankName              String?   @default("MB")
  levelsConfig          String    // JSON: { "STARTERS": 1200000, "MOVERS": 1300000, ... }
  status                String    @default("OPEN") // OPEN (Đang mở), CLOSED (Đã đóng), COMPLETED (Đã thi xong)
  notes                 String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  registrations         CambridgeRegistration[]
}

model CambridgeRegistration {
  id                  Int                   @id @default(autoincrement())
  batchId             String
  batch               CambridgeExamBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId           String?
  student             Student?              @relation(fields: [studentId], references: [id], onDelete: SetNull)

  // Thông tin thí sinh chuẩn VN120 & Cambridge
  fullName            String                // Tên tiếng Việt có dấu
  fullNameNoTone      String                // In hoa không dấu: BUI THAO NGAN
  gender              String                // MALE / FEMALE
  dob                 DateTime?             // Ngày tháng năm sinh
  dobStr              String?               // Chuỗi dd/MM/yyyy
  parentPhone         String?               // SĐT phụ huynh
  parentEmail         String?               // Email nhận xác nhận & biên lai
  level               String                // STARTERS, MOVERS, FLYERS, KET, PET
  fee                 Float                 // Lệ phí thi

  // Quản lý thanh toán & Biên lai điện tử
  paymentStatus       String                @default("CHUA_DONG") // CHUA_DONG, DA_DONG
  paymentDate         DateTime?             // Thời điểm kế toán xác nhận
  receiptCode         String?               // Mã biên lai: BL-CAM-yyMMdd-xx
  receiptSentAt       DateTime?             // Thời gian gửi email biên lai
  receiptSentBy       String?               // Kế toán / Admin duyệt
  transferContent     String?               // CAM - BUI THAO NGAN

  // Kết quả khảo thí từ Cambridge
  listeningScore      String?               // vd: 4 khiên
  readingWritingScore String?               // vd: 5 khiên
  speakingScore       String?               // vd: 5 khiên
  totalScore          String?               // vd: 14 khiên (14/15)
  grade               String?               // Pass with Merit / Distinction...
  certificateNumber   String?               // Số hiệu chứng chỉ
  certificateDate     DateTime?             // Ngày cấp chứng chỉ
  certificateUrl      String?               // Link ảnh scan chứng chỉ

  notes               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([batchId])
  @@index([studentId])
  @@index([level])
  @@index([paymentStatus])
}
